#:set nlev = "YDCPG_OPTS%KFLEVG"
#:else
#:set nlev = "NLEV"
#:endif

#:if use_ydmodel
USE TYPE_MODEL, ONLY : MODEL
#:endif
#:if use_yddphy
USE YOMDPHY, ONLY : TDPHY
#:endif
#:if use_yddyna
USE YOMDYNA, ONLY : TDYNA
#:endif
#:if use_ydsurf
USE SURFACE_FIELDS_MIX, ONLY : TSURF
#:endif

CLASS (${name}$)                    :: SELF
#:if use_llt0
INTEGER(KIND=JPIM),           INTENT (IN)    :: KT
#:endif
TYPE (FIELD_REGISTRY),        INTENT (INOUT) :: REGISTRY
#:if use_cpg_dim
TYPE (CPG_OPTS_TYPE),         INTENT (IN)    :: YDCPG_OPTS
#:else
INTEGER (KIND=JPIM),          INTENT (IN)    :: NLEV
#:endif
#:if use_ydmodel
TYPE (MODEL),                 INTENT (IN)    :: YDMODEL
#:endif
#:if use_yddphy
TYPE (TDPHY),                 INTENT (IN)    :: YDDPHY
#:endif
#:if use_yddyna
TYPE (TDYNA),                 INTENT (IN)    :: YDDYNA
#:endif
#:if use_ydsurf
TYPE (TSURF),                 INTENT (IN)    :: YDSURF
#:endif
#:if use_llmf_phys
LOGICAL, OPTIONAL,            INTENT (IN)    :: LDMF_PHYS
#:endif

#:for var in vars
  #:if vars[var][ISARG]
    #:set ndim = 1 + len (vars[var][NDIMS]) + 1
REAL(KIND=JPRB),       INTENT (IN), OPTIONAL, TARGET  :: ${argn (var)}$(${", ".join ([":"] * ndim)}$)
  #:endif
#:endfor

#:if use_llt0
LOGICAL :: LLT0
#:endif
#:if use_llmf_phys
LOGICAL :: LLMF_PHYS
#:endif

#:if use_intdyn
TYPE (TRCP)   , POINTER :: YLTRCP     
TYPE (TCTY)   , POINTER :: YLTCTY     
TYPE (THWIND) , POINTER :: YLTHW     
TYPE (TXYB)   , POINTER :: YLTXYB     
TYPE (TXYB)   , POINTER :: YLTXYB_PHY
TYPE (TXYBDER), POINTER :: YLTXYBDER

TYPE (TCTY),   TARGET :: YLTCTY0 
TYPE (THWIND), TARGET :: YLTHW0, YLTHW9 
TYPE (TRCP),   TARGET :: YLTRCP0, YLTRCP9 
TYPE (TXYB),   TARGET :: YLTXYB0, YLTXYB0_PHY, YLTXYB9, YLTXYB9_PHY
TYPE (TXYBDER),TARGET :: YLTXYBDER0

YLTCTY0     = YYTCTY0 
YLTHW0      = YYTHW0 
YLTHW9      = YYTHW9 
YLTRCP0     = YYTRCP0 
YLTRCP9     = YYTRCP9 
YLTXYB0     = YYTXYB0 
YLTXYB0_PHY = YYTXYB0_PHY 
YLTXYB9     = YYTXYB9 
YLTXYB9_PHY = YYTXYB9_PHY
YLTXYBDER0  = YYTXYBDER0
#:endif

#:if use_llt0
LLT0 = KT == 0
#:endif

#:if use_intdyn
YLTRCP     => NULL ()
YLTCTY     => NULL ()
YLTHW      => NULL ()
YLTXYB     => NULL ()
YLTXYB_PHY => NULL ()
YLTXYBDER  => NULL ()

IF (KT == 0) THEN
  YLTRCP     => YLTRCP0
  YLTCTY     => YLTCTY0
  YLTHW      => YLTHW0
  YLTXYB     => YLTXYB0
  YLTXYB_PHY => YLTXYB0_PHY
  YLTXYBDER  => YLTXYBDER0
ELSEIF (KT == 9) THEN
  YLTRCP     => YLTRCP9
  YLTCTY     => NULL ()
  YLTHW      => YLTHW9
  YLTXYB     => YLTXYB9
  YLTXYB_PHY => YLTXYB9_PHY
ENDIF
#:endif

#:if use_llmf_phys
LLMF_PHYS = .FALSE.
IF (PRESENT (LDMF_PHYS)) THEN
  LLMF_PHYS = LDMF_PHYS
ENDIF
#:endif

SELF%ISIZE = 0

#:for var in vars
!PRINT *, "${var}$", SELF%ISIZE
  #:set elt = vars[var]
  #:if not elt[NCOND] is None
    #:set ind = "  "
IF (${elt[NCOND]}$) THEN
  #:else
    #:set ind = ""
  #:endif
  #:if (elt[NTYPE] is None) or (elt[NTYPE] == 'INTEGER')
    #:if elt[ISARG]
${ind}$IF (PRESENT (${argn (var)}$)) THEN
      #:if elt[ELARG]
${ind}$ELSE
${ind}$  SELF%ISIZE = SELF%ISIZE + MALIGN (${size (elt[NDIMS], elt[NTYPE])}$)
      #:endif
${ind}$ENDIF
    #:else
${ind}$SELF%ISIZE = SELF%ISIZE + MALIGN (${size (elt[NDIMS], elt[NTYPE])}$)
    #:endif
  #:elif (NDEFS < len (elt)) and (elt[NDEFS] is not None)
    #:set defs = elt[NDEFS]
    #:if elt[ISARG]
${ind}$CALL SELF%${var}$%INIT_STACK (REGISTRY, ${nlev}$, ${defs}$, ${argn (var)}$)
IF (.NOT. PRESENT (${argn (var)}$)) THEN
${ind}$  SELF%ISIZE = SELF%ISIZE + SELF%${var}$%SIZE_STACK ()
ENDIF
    #:else
${ind}$CALL SELF%${var}$%INIT_STACK (REGISTRY, ${nlev}$, ${defs}$)
${ind}$SELF%ISIZE = SELF%ISIZE + SELF%${var}$%SIZE_STACK ()
    #:endif
  #:else
    #:if (var == "T0") or (var == "T9")
      #:set kt = var[1] + ", "
    #:else
      #:set kt = ""
    #:endif
    #:if elt[ISARG]
${ind}$CALL SELF%${var}$%INIT_STACK (${kt}$REGISTRY, ${nlev}$, ${argn (var)}$)
${ind}$SELF%ISIZE = SELF%ISIZE + SELF%${var}$%SIZE_STACK ()
    #:else
${ind}$CALL SELF%${var}$%INIT_STACK (${kt}$REGISTRY, ${nlev}$)
${ind}$SELF%ISIZE = SELF%ISIZE + SELF%${var}$%SIZE_STACK ()
    #:endif
  #:endif
  #:if not elt[NCOND] is None
ENDIF
  #:endif

#:endfor

END SUBROUTINE ${name}$_INIT_STACK

SUBROUTINE ${name}$_ALLOC_STACK (SELF &
#:if use_llt0
                                & , KT  &
#:endif
                                & , REGISTRY &
#:if use_cpg_dim
                                & , YDCPG_OPTS &
#:else
                                & , NLEV &
#:endif
#:if use_yddphy
                                & , YDDPHY &
#:endif
#:if use_yddyna
                                & , YDDYNA &
#:endif
#:if use_ydsurf
                                & , YDSURF &
#:endif
#:if use_ydmodel
                                & , YDMODEL &
#:endif
#:if use_llmf_phys
                                & , LDMF_PHYS &
#:endif
#:for var in vars
  #:if vars[var][ISARG]
                                &, ${argn (var)}$ &
  #:endif
#:endfor
                                &, YDSTACK &
                           &)

#:if use_intdyn
USE INTDYN_MOD, ONLY : YYTCTY0, YYTRCP0, YYTHW0, YYTXYB0, YYTXYB0_PHY, YYTXYBDER0
USE INTDYN_MOD, ONLY :          YYTRCP9, YYTHW9, YYTXYB9, YYTXYB9_PHY
USE INTDYN_MOD, ONLY : TRCP, TCTY, THWIND, TXYB, TXYBDER
#:endif

USE STACK_MOD, ONLY : STACK

#:if use_cpg_dim
USE CPG_OPTS_TYPE_MOD, ONLY : CPG_OPTS_TYPE
#:set nlev = "YDCPG_OPTS%KFLEVG"
#:else
#:set nlev = "NLEV"
#:endif

#:if use_ydmodel
USE TYPE_MODEL, ONLY : MODEL
#:endif
#:if use_yddphy
USE YOMDPHY, ONLY : TDPHY
#:endif
#:if use_yddyna
USE YOMDYNA, ONLY : TDYNA
#:endif
#:if use_ydsurf
USE SURFACE_FIELDS_MIX, ONLY : TSURF
#:endif

CLASS (${name}$)                    :: SELF
#:if use_llt0
INTEGER(KIND=JPIM),           INTENT (IN)    :: KT
#:endif
TYPE (FIELD_REGISTRY),        INTENT (INOUT) :: REGISTRY
#:if use_cpg_dim
TYPE (CPG_OPTS_TYPE),         INTENT (IN)    :: YDCPG_OPTS
#:else
INTEGER (KIND=JPIM),          INTENT (IN)    :: NLEV
#:endif
#:if use_ydmodel
TYPE (MODEL),                 INTENT (IN)    :: YDMODEL
#:endif
#:if use_yddphy
TYPE (TDPHY),                 INTENT (IN)    :: YDDPHY
#:endif
#:if use_yddyna
TYPE (TDYNA),                 INTENT (IN)    :: YDDYNA
#:endif
#:if use_ydsurf
TYPE (TSURF),                 INTENT (IN)    :: YDSURF
#:endif
#:if use_llmf_phys
LOGICAL, OPTIONAL,            INTENT (IN)    :: LDMF_PHYS
#:endif

#:for var in vars
  #:if vars[var][ISARG]
    #:set ndim = 1 + len (vars[var][NDIMS]) + 1
REAL(KIND=JPRB),       INTENT (IN), OPTIONAL, TARGET  :: ${argn (var)}$(${", ".join ([":"] * ndim)}$)
  #:endif
#:endfor
TYPE (STACK)                                 :: YDSTACK

#:if use_llt0
LOGICAL :: LLT0
#:endif
#:if use_llmf_phys
LOGICAL :: LLMF_PHYS
#:endif

#:if use_intdyn
TYPE (TRCP)   , POINTER :: YLTRCP     
TYPE (TCTY)   , POINTER :: YLTCTY     
TYPE (THWIND) , POINTER :: YLTHW     
TYPE (TXYB)   , POINTER :: YLTXYB     
TYPE (TXYB)   , POINTER :: YLTXYB_PHY
TYPE (TXYBDER), POINTER :: YLTXYBDER

TYPE (TCTY),   TARGET :: YLTCTY0 
TYPE (THWIND), TARGET :: YLTHW0, YLTHW9 
TYPE (TRCP),   TARGET :: YLTRCP0, YLTRCP9 
TYPE (TXYB),   TARGET :: YLTXYB0, YLTXYB0_PHY, YLTXYB9, YLTXYB9_PHY
TYPE (TXYBDER),TARGET :: YLTXYBDER0

YLTCTY0     = YYTCTY0 
YLTHW0      = YYTHW0 
YLTHW9      = YYTHW9 
YLTRCP0     = YYTRCP0 
YLTRCP9     = YYTRCP9 
YLTXYB0     = YYTXYB0 
YLTXYB0_PHY = YYTXYB0_PHY 
YLTXYB9     = YYTXYB9 
YLTXYB9_PHY = YYTXYB9_PHY
YLTXYBDER0  = YYTXYBDER0
#:endif


#:if use_llt0
LLT0 = KT == 0
#:endif

#:if use_intdyn
YLTRCP     => NULL ()
YLTCTY     => NULL ()
YLTHW      => NULL ()
YLTXYB     => NULL ()
YLTXYB_PHY => NULL ()
YLTXYBDER  => NULL ()

IF (KT == 0) THEN
  YLTRCP     => YLTRCP0
  YLTCTY     => YLTCTY0
  YLTHW      => YLTHW0
  YLTXYB     => YLTXYB0
  YLTXYB_PHY => YLTXYB0_PHY
  YLTXYBDER  => YLTXYBDER0
ELSEIF (KT == 9) THEN
  YLTRCP     => YLTRCP9
  YLTCTY     => NULL ()
  YLTHW      => YLTHW9
  YLTXYB     => YLTXYB9
  YLTXYB_PHY => YLTXYB9_PHY
ENDIF
#:endif

#:if use_llmf_phys
LLMF_PHYS = .FALSE.
IF (PRESENT (LDMF_PHYS)) THEN
  LLMF_PHYS = LDMF_PHYS
ENDIF
#:endif

#:for var in vars
!PRINT *, "${var}$", YDSTACK%IPTR-70785, YDSTACK%IPTR
  #:set elt = vars[var]
  #:if not elt[NCOND] is None
    #:set ind = "  "
IF (${elt[NCOND]}$) THEN
  #:else
    #:set ind = ""
  #:endif
  #:if (elt[NTYPE] is None) or (elt[NTYPE] == 'INTEGER')
    #:set ss = pdim (elt[NDIMS] + [['1']])
    #:if elt[ISARG]
${ind}$IF (PRESENT (${argn (var)}$)) THEN
${ind}$ SELF%${var}$_ALL ${ss}$ => ${argn (var)}$ 
      #:if elt[ELARG]
${ind}$ELSE
${ind}$  CALL YDSTACK%ALLOC (SELF%${var}$, KUBDS=[${pdimu (elt[NDIMS])}$], KLBDS=[${pdiml (elt[NDIMS])}$])
      #:endif
${ind}$ENDIF
    #:else
${ind}$  CALL YDSTACK%ALLOC (SELF%${var}$, KUBDS=[${pdimu (elt[NDIMS])}$], KLBDS=[${pdiml (elt[NDIMS])}$])
    #:endif
  #:elif (NDEFS < len (elt)) and (elt[NDEFS] is not None)
    #:set defs = elt[NDEFS]
    #:if elt[ISARG]
${ind}$CALL SELF%${var}$%ALLOC_STACK (REGISTRY, ${nlev}$, ${defs}$, ${argn (var)}$, YDSTACK)
    #:else
${ind}$CALL SELF%${var}$%ALLOC_STACK (REGISTRY, ${nlev}$, ${defs}$, YDSTACK=YDSTACK)
    #:endif
  #:else
    #:if (var == "T0") or (var == "T9")
      #:set kt = var[1] + ", "
    #:else
      #:set kt = ""
    #:endif
    #:if elt[ISARG]
${ind}$CALL SELF%${var}$%ALLOC_STACK (${kt}$REGISTRY, ${nlev}$, ${argn (var)}$, YDSTACK)
    #:else
${ind}$CALL SELF%${var}$%ALLOC_STACK (${kt}$REGISTRY, ${nlev}$, YDSTACK=YDSTACK)
    #:endif
  #:endif
  #:if not elt[NCOND] is None
ENDIF
  #:endif

#:endfor

END SUBROUTINE ${name}$_ALLOC_STACK

SUBROUTINE ${name}$_UPDATE_VIEW_STACK (SELF, BLOCK_INDEX)

CLASS (${name}$)                    :: SELF
INTEGER (KIND=JPIM), INTENT (IN)    :: BLOCK_INDEX

#:for var in vars
  #:set elt = vars[var]
  #:if (elt[NTYPE] is None) or (elt[NTYPE] == 'INTEGER')
    #:set ss = pdim (elt[NDIMS] + [])
    #:set ndim = 1 + len (vars[var][NDIMS])
    #:if elt[ISARG]
IF (ASSOCIATED (SELF%${var}$_ALL)) THEN
  SELF%${var}$ ${ss}$ => SELF%${var}$_ALL (${", ".join ([":"] * ndim)}$, BLOCK_INDEX)
ENDIF
    #:else
    #:endif
  #:elif (NDEFS < len (elt)) and (elt[NDEFS] is not None)
    #:set defs = elt[NDEFS]
    #:if elt[ISARG]
CALL SELF%${var}$%UPDATE_VIEW_STACK (BLOCK_INDEX)
    #:else
CALL SELF%${var}$%UPDATE_VIEW_STACK (BLOCK_INDEX)
    #:endif
  #:else
    #:if (var == "T0") or (var == "T9")
      #:set kt = var[1] + ", "
    #:else
      #:set kt = ""
    #:endif
    #:if elt[ISARG]
CALL SELF%${var}$%UPDATE_VIEW_STACK (BLOCK_INDEX)
    #:else
CALL SELF%${var}$%UPDATE_VIEW_STACK (BLOCK_INDEX)
    #:endif
  #:endif
#:endfor

END SUBROUTINE ${name}$_UPDATE_VIEW_STACK

INTEGER (KIND=JPIB) FUNCTION ${name}$_SIZE_STACK (SELF)

CLASS (${name}$)         :: SELF

${name}$_SIZE_STACK = SELF%ISIZE

END FUNCTION ${name}$_SIZE_STACK

#:endif

SUBROUTINE ${name}$_UPDATE_VIEW (SELF, BLOCK_INDEX)

CLASS (${name}$)         :: SELF
INTEGER(KIND=JPIM), INTENT (IN)   :: BLOCK_INDEX

#:for var in vars
  #:set elt = vars[var]
  #:if elt[NTYPE] is None
    #:set ss = pdim (elt[NDIMS])
    #:set ndim = 1 + len (elt[NDIMS])
    #:if use_lbounds
      #:set ss = ""
    #:endif
IF (ASSOCIATED (SELF%F_${var}$)) THEN
  IF ((.NOT. SELF%F_${var}$%THREAD_BUFFER) .OR. (.NOT. ASSOCIATED (SELF%${var}$))) THEN
    SELF%${var}$ ${ss}$ => SELF%F_${var}$%GET_VIEW (BLOCK_INDEX)
  ENDIF
ELSEIF (.NOT. ASSOCIATED (SELF%${var}$)) THEN
  SELF%${var}$ ${ss}$ => ZDUM${ndim}$
ENDIF
  #:elif elt[NTYPE] == 'INTEGER'
    #:set ss = pdim (elt[NDIMS])
    #:set ndim = 1 + len (elt[NDIMS])
IF (ASSOCIATED (SELF%F_${var}$)) THEN
  IF ((.NOT. SELF%F_${var}$%THREAD_BUFFER) .OR. (.NOT. ASSOCIATED (SELF%${var}$))) THEN
    SELF%${var}$ ${ss}$ => SELF%F_${var}$%GET_VIEW (BLOCK_INDEX)
  ENDIF
ELSEIF (.NOT. ASSOCIATED (SELF%${var}$)) THEN
  SELF%${var}$ ${ss}$ => IDUM${ndim}$
ENDIF
  #:else
CALL SELF%${var}$%UPDATE_VIEW (BLOCK_INDEX)
  #:endif
#:endfor

END SUBROUTINE ${name}$_UPDATE_VIEW

SUBROUTINE ${name}$_FINAL (SELF)
CLASS (${name}$)         :: SELF

#:for var in vars
  #:set elt = vars[var]
  #:if (elt[NTYPE] is None) or (elt[NTYPE] == 'INTEGER')
IF (ASSOCIATED (SELF%F_${var}$)) CALL DELETE_TEMPORARY (SELF%F_${var}$) 
  #:else
CALL SELF%${var}$%FINAL ()
  #:endif
#:endfor

END SUBROUTINE ${name}$_FINAL
#:enddef pcpg_type_methods


