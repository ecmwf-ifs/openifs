#!/usr/bin/env bash

# Reset the test directory by deleting everything except symlinks
# created during the configuration and files named in a safelist.

# The safelist includes:
# * files that may already exist when this script is run at the start of a job
# * files kept between runs for bit-identity checks
declare -a safelist=(stdout.log stderr.log SAVED_NORMS reference.json)

for file in *; do
  if [[ -L "${file}" ]]; then
    # Remove any symlinks going through xdata
    if [[ $(readlink $file) =~ /xdata/ ]]; then
      rm -f "${file}"
    fi
  elif [[ ! " ${safelist[*]} " =~ [[:space:]]${file}[[:space:]] ]]; then
    # Not a symlink or in the safelist; delete.
    rm -rf "${file}"
  fi
done

# Remove broken symlinks left over after deleting files:
find . -xtype l -exec rm -f {} +
